NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/atelier_care
SESSION_TTL_HOURS=168
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:5000

# Set only for the one-time doctor provisioning command; do not commit real values.
DOCTOR_EMAIL=
DOCTOR_NAME=
DOCTOR_PASSWORD=

# Provider integrations remain disabled until configured server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set this exact API URL as an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Add this second exact URL to the same OAuth client for Calendar connection.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback
# Generate a unique random 32-byte key. Keep it stable; it encrypts refresh tokens in PostgreSQL.
GOOGLE_TOKEN_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional E.164 phone for doctor SMS sign-in (for example +91...).
DOCTOR_PHONE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMS_API_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
