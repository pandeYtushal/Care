# Copy the server/client examples to their corresponding .env files.
NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/atelier_care
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Private object storage for medical files
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payment provider (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar / Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# WhatsApp Business Platform
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Password reset email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
